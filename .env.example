POSTGRES_PORT=5433
API_PORT=8080
FRONTEND_PORT=5173
CHATBOT_PORT=8000

POSTGRES_DB=nekobox
POSTGRES_USER=nekobox
POSTGRES_PASSWORD=nekobox_local

BD_URL=jdbc:postgresql://localhost:5433/nekobox
BD_ADMIN=nekobox
BD_SENHA=nekobox_local

CLOUDINARY_URL=cloudinary://api-key:api-secret@cloud-name
CLOUDINARY_MEDIA_ROOT=nekobox/games
CLOUDINARY_SCREENSHOT_COUNT=10

GOOGLE_API_KEY=

# Histórico público do GameBot (MongoDB; não usar VITE_ para estes valores)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=nekobox
MONGODB_CONVERSATIONS_COLLECTION=chat_mensagens
MONGODB_SERVER_SELECTION_TIMEOUT_MS=3000

APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GAME_GIFT_ENCRYPTION_KEY=replace-with-a-long-random-secret

VITE_API_BASE_URL=http://localhost:8080
VITE_CHATBOT_API_URL=http://localhost:8000
VITE_CLOUDINARY_CLOUD_NAME=cloud-name
VITE_CLOUDINARY_MEDIA_AUDIT=true
